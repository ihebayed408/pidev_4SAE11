// CI/CD pipeline for the Subcontracting microservice (monorepo: pidev_4SAE11).
// Script Path in Jenkins: backEnd/Microservices/Subcontracting/Jenkinsfile
// Credentials: GithubCredentials (SCM), DockerHubCrendentials (push), SonarQube (server with SonarQube Token).
// Prometheus: set PROMETHEUS_PUSHGATEWAY_URL (e.g. http://192.168.1.13:9091) to push build metrics.
pipeline {
    agent any

    options {
        skipDefaultCheckout()
    }

    parameters {
        string(name: 'REPO_URL', defaultValue: '', description: 'Git repository URL (leave empty to use job SCM config)')
        string(name: 'BRANCH', defaultValue: 'main', description: 'Branch to build')
        string(name: 'IMAGE_REPO', defaultValue: '', description: 'Registry/repo prefix (unused, reserved for orchestrator)')
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Docker image tag override')
        booleanParam(name: 'PUSH_IMAGE', defaultValue: true, description: 'Push Docker image to registry')
        booleanParam(name: 'RUN_SONARQUBE', defaultValue: true, description: 'Run SonarQube analysis')
        booleanParam(name: 'TRIGGER_DOWNSTREAM', defaultValue: false, description: 'Trigger downstream jobs')
    }

    environment {
        SUBCONTRACTING_DIR = 'backEnd/Microservices/Subcontracting'
        DOCKER_IMAGE = 'ihebayed408/subcontracting-microservice'
        DOCKER_TAG = "${params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : (env.BUILD_NUMBER ?: 'latest')}"
        JOB_NAME_SAFE = "${env.JOB_NAME?.replaceAll('[^a-zA-Z0-9]', '_') ?: 'subcontracting'}"
        PATH          = "/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                sh 'git config --global http.version HTTP/1.1'
                sh 'git config --global http.postBuffer 524288000'
                script {
                    if (params.REPO_URL?.trim()) {
                        checkout([$class: 'GitSCM',
                            branches: [[name: "*/${params.BRANCH}"]],
                            userRemoteConfigs: [[url: params.REPO_URL]],
                            doGenerateSubmoduleConfigurations: false,
                            extensions: [
                                [$class: 'CleanBeforeCheckout'],
                                [$class: 'CloneOption', shallow: true, depth: 1, noTags: true, honorRefspec: true, timeout: 20],
                                [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                                    [$class: 'SparseCheckoutPath', path: SUBCONTRACTING_DIR]
                                ]]
                            ]
                        ])
                    } else {
                        checkout([
                            $class: 'GitSCM',
                            branches: scm.branches,
                            userRemoteConfigs: scm.userRemoteConfigs,
                            doGenerateSubmoduleConfigurations: false,
                            submoduleCfg: [],
                            extensions: [
                                [$class: 'CleanBeforeCheckout'],
                                [$class: 'CloneOption', shallow: true, depth: 1, noTags: true, honorRefspec: true, timeout: 20],
                                [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                                    [$class: 'SparseCheckoutPath', path: SUBCONTRACTING_DIR]
                                ]]
                            ]
                        ])
                    }
                }
            }
        }

        stage('Build & Test') {
            steps {
                dir(SUBCONTRACTING_DIR) {
                    sh 'if [ -f mvnw ]; then chmod +x mvnw && ./mvnw clean verify -B; else mvn clean verify -B; fi'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${SUBCONTRACTING_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('SonarQube Analysis') {
            when { expression { return params.RUN_SONARQUBE } }
            steps {
                dir(SUBCONTRACTING_DIR) {
                    withCredentials([string(credentialsId: 'SonarQubeToken', variable: 'SONAR_TOKEN')]) {
                        withSonarQubeEnv('SonarQube') {
                            sh 'if [ -f mvnw ]; then chmod +x mvnw && ./mvnw sonar:sonar -Dsonar.projectKey=Subcontracting -Dsonar.projectName=Subcontracting -Dsonar.token=$SONAR_TOKEN; else mvn sonar:sonar -Dsonar.projectKey=Subcontracting -Dsonar.projectName=Subcontracting -Dsonar.token=$SONAR_TOKEN; fi'
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            when { expression { return params.RUN_SONARQUBE } }
            steps {
                dir(SUBCONTRACTING_DIR) {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        timeout(time: 2, unit: 'MINUTES') {
                            waitForQualityGate abortPipeline: false
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir(SUBCONTRACTING_DIR) {
                    script {
                        docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                    }
                }
            }
        }

        stage('Docker Push') {
            when { expression { return params.PUSH_IMAGE } }
            steps {
                withCredentials([usernamePassword(credentialsId: 'DockerHubCrendentials', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                    sh '''
                        echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest
                        docker push ${DOCKER_IMAGE}:latest
                        docker logout || true
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.PROMETHEUS_PUSHGATEWAY_URL?.trim()) {
                    def status = currentBuild.result == 'SUCCESS' ? 1 : 0
                    def duration = (System.currentTimeMillis() - currentBuild.startTimeInMillis) / 1000.0
                    writeFile file: 'prometheus_metrics.txt', text: """# HELP jenkins_build_result Build result (1=success, 0=failure)
# TYPE jenkins_build_result gauge
jenkins_build_result{job="${JOB_NAME_SAFE}",build_number="${env.BUILD_NUMBER}"} ${status}
# HELP jenkins_build_duration_seconds Build duration in seconds
# TYPE jenkins_build_duration_seconds gauge
jenkins_build_duration_seconds{job="${JOB_NAME_SAFE}",build_number="${env.BUILD_NUMBER}"} ${duration}
"""
                    sh "curl -s --data-binary @prometheus_metrics.txt '${env.PROMETHEUS_PUSHGATEWAY_URL}/metrics/job/${JOB_NAME_SAFE}/instance/${env.BUILD_NUMBER}' || true"
                }
            }
            cleanWs()
        }
        failure {
            echo 'Pipeline failed'
        }
        success {
            echo 'Pipeline succeeded'
        }
    }
}
